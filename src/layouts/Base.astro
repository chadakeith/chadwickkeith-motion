---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { MEASUREMENT_ID, SITE } from "../data/site";
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: string;
  image?: string;
  jsonLd?: unknown;
  articleDate?: string;
}

const {
  title,
  description,
  path,
  ogType = "website",
  image,
  jsonLd,
  articleDate,
} = Astro.props;

const canonical = new URL(path, SITE).href;
const imageUrl = image ? new URL(image, SITE).href : undefined;

function jsonScript(value: unknown) {
  return JSON.stringify(value).replace(/</g, "\\u003c");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Chad Keith" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Chad Keith" />
    <meta property="og:locale" content="en_US" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content="Chad Keith" />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonScript(jsonLd)} />}
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", MEASUREMENT_ID);
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("reduced-motion");
          return;
        }
        var supports = false;
        try {
          supports =
            CSS.supports("animation-timeline: view()") ||
            CSS.supports("animation-timeline", "view()");
        } catch (e) {}
        root.classList.add(supports ? "motion-css" : "motion-io");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains("motion-io")) return;

        var revealSelector = [
          ".quest-card",
          ".skill-card",
          ".project-card",
          ".stat-card",
          ".archive-item",
          ".cert-card",
          ".cert-image-card",
          ".service-card",
          ".client-item",
          ".timeline-item",
          ".cta-panel",
          ".chip",
          ".about-text p",
          ".section-desc",
          ".section-label",
          "section > h2",
          ".page-hero h1",
          ".pin-beat",
        ].join(",");

        var desktopQuery = window.matchMedia("(min-width: 900px)");
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("in-view");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.14 }
        );

        function arm(el) {
          if (el.dataset.armed === "1") return;
          el.dataset.armed = "1";
          var rect = el.getBoundingClientRect();
          var visible = rect.top < window.innerHeight * 0.92 && rect.bottom > 40;
          if (visible) el.classList.add("in-view");
          else io.observe(el);
        }

        function armReveals() {
          document.querySelectorAll(revealSelector).forEach(function (el) {
            if (el.classList.contains("pin-beat") && desktopQuery.matches) return;
            arm(el);
          });
        }

        var story = document.querySelector(".pin-story");
        var beats = story ? [].slice.call(story.querySelectorAll(".pin-beat")) : [];

        function updatePin() {
          if (!story || !beats.length || !desktopQuery.matches) {
            beats.forEach(function (beat) { beat.classList.remove("is-active"); });
            return;
          }
          var rect = story.getBoundingClientRect();
          var total = Math.max(story.offsetHeight - window.innerHeight, 1);
          var scrolled = Math.min(Math.max(-rect.top, 0), total);
          var progress = scrolled / total;
          var index = Math.min(beats.length - 1, Math.floor(progress * beats.length));
          if (progress >= 0.98) index = beats.length - 1;
          beats.forEach(function (beat, i) {
            beat.classList.toggle("is-active", i === index);
          });
        }

        armReveals();
        updatePin();
        window.addEventListener("scroll", updatePin, { passive: true });
        window.addEventListener("resize", function () {
          if (!desktopQuery.matches) armReveals();
          updatePin();
        }, { passive: true });
      })();
    </script>
  </body>
</html>
